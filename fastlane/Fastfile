# fastlane ios beta: build the iPhone app, sign it with the App Store Connect API key, upload to TestFlight.
# Used by .github/workflows/ios.yml. Locally on a Mac: set the same environment variables and run `fastlane ios beta`.
default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci if ENV["CI"]
    key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: ENV["ASC_KEY_PATH"])
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: key) + 1)
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} -allowProvisioningUpdates " \
              "-authenticationKeyPath #{ENV['ASC_KEY_PATH']} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      output_directory: "build"
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end
end
